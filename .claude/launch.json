{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gts-web",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npx vite --port ${PORT:-5173} --strictPort"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "gts-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npx vite preview --port ${PORT:-4173} --strictPort"
      ],
      "port": 4173,
      "autoPort": true
    }
  ]
}